{
  "name": "pi-observability",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension that records agent runs (reasoning, tool calls, results, usage) in RawTree",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.mjs",
    "config.mjs",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:cli": "node --test test/cli.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "typebox": "1.3.27"
  },
  "pi": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.3"
  },
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawtreedb/pi-observability.git"
  },
  "homepage": "https://github.com/rawtreedb/pi-observability#readme",
  "bugs": {
    "url": "https://github.com/rawtreedb/pi-observability/issues"
  }
}
